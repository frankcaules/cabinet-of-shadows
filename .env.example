# Cabinet of Shadows — environment variables
#
# Copy this file to `.env.local` for local development overrides;
# `.env.local` is git-ignored. Set the live values on Vercel under
# Project Settings → Environment Variables (Production + Preview +
# Development).

# Google Tag Manager container ID. When set, the GTM script is
# injected from app/layout.tsx via @next/third-parties; when empty
# or unset, no tracking script is loaded. GA4 is configured as a tag
# inside the GTM container — there is no separate gtag.js loader.
# Format: GTM-XXXXXXX. Leave empty in local .env.local to opt out
# (development sessions should typically run without tracking).
NEXT_PUBLIC_GTM_ID=
